Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"dvec", "[", 
      RowBox[{"kx_", ",", "ky_", ",", "mu_"}], "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"DeltaE", "*", 
        RowBox[{"Sin", "[", "kx", "]"}]}], ",", 
       RowBox[{"DeltaE", "*", 
        RowBox[{"Sin", "[", "ky", "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Cos", "[", "kx", "]"}], "+", 
           RowBox[{"Cos", "[", "ky", "]"}]}], ")"}]}], "-", "mu"}]}], "}"}]}],
     ";"}], "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"computeChern", "[", "mu_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "integrand", ",", "kx", ",", "ky", ",", "d", ",", "dx", ",", "dy"}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"dx", "=", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"dvec", "[", 
            RowBox[{"kx", ",", "ky", ",", "dA1"}], "]"}], ",", "kx"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"dy", "=", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"dvec", "[", 
            RowBox[{"kx", ",", "ky", ",", "dA1"}], "]"}], ",", "ky"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"integrand", "[", 
          RowBox[{"k1_", ",", "k2_"}], "]"}], ":=", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"d", "=", 
            RowBox[{"dvec", "[", 
             RowBox[{"k1", ",", "k2", ",", "mu"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Dot", "[", 
             RowBox[{"d", ",", 
              RowBox[{"Cross", "[", 
               RowBox[{
                RowBox[{"dx", "/.", " ", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"kx", "->", "k1"}], ",", 
                   RowBox[{"ky", "->", "k2"}]}], "}"}]}], ",", 
                RowBox[{"dy", "/.", " ", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"kx", "->", "k1"}], ",", 
                   RowBox[{"ky", "->", "k2"}]}], "}"}]}]}], "]"}]}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Norm", "[", "d", "]"}], "^", "3"}], ")"}]}]}], ")"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{"4", " ", "Pi"}], ")"}]}], ")"}], "*", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{"integrand", "[", 
            RowBox[{"k1", ",", "k2"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k1", ",", 
             RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"k2", ",", 
             RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
           RowBox[{"PrecisionGoal", "->", "5"}], ",", 
           RowBox[{"AccuracyGoal", "->", "6"}], ",", 
           RowBox[{"Method", "->", "\"\<GlobalAdaptive\>\""}], ",", 
           RowBox[{"MaxRecursion", "->", "20"}]}], "]"}]}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Sweep", " ", "DeltaA1", " ", "from", " ", "0", " ", "to", " ", "2.0"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dA1Values", "=", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "5"}], ",", "5", ",", "0.01"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"chernResults", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"val", ",", 
         RowBox[{"Round", "[", 
          RowBox[{"computeChern", "[", "val", "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"val", ",", "dA1Values"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "Plotting", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{"chernResults", ",", 
     RowBox[{"InterpolationOrder", "->", "0"}], ",", 
     RowBox[{"(*", 
      RowBox[{
      "Makes", " ", "it", " ", "look", " ", "like", " ", "a", " ", "proper", " ",
        "step", " ", "function"}], "*)"}], 
     RowBox[{"PlotStyle", "->", "Thick"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Mu]\>\"", ",", "\"\<Chern Number\>\""}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}]}], "]"}]}]}]], "Input",
