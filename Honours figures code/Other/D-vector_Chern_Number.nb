Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Parameters", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"DeltaE", "=", "0.1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"DeltaA1", "=", "0.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"epsilon0", "=", "0.01"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dvec", "[", 
      RowBox[{"kx_", ",", "ky_"}], "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"DeltaE", "*", 
         RowBox[{"Sin", "[", "kx", "]"}]}], "+", 
        RowBox[{"DeltaA1", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Cos", "[", "kx", "]"}], "+", 
           RowBox[{"Cos", "[", "ky", "]"}]}], ")"}]}]}], ",", 
       RowBox[{"DeltaE", "*", 
        RowBox[{"Sin", "[", "ky", "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Cos", "[", "kx", "]"}], "+", 
           RowBox[{"Cos", "[", "ky", "]"}]}], ")"}]}], "-", "epsilon0"}]}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gradX", "[", 
      RowBox[{"kx_", ",", "ky_"}], "]"}], "=", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"dvec", "[", 
        RowBox[{"kx", ",", "ky"}], "]"}], ",", "kx"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gradY", "[", 
      RowBox[{"kx_", ",", "ky_"}], "]"}], "=", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"dvec", "[", 
        RowBox[{"kx", ",", "ky"}], "]"}], ",", "ky"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"integrand", "[", 
      RowBox[{"kx_", ",", "ky_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"d", ",", "dx", ",", "dy"}], "}"}], ",", 
       RowBox[{
        RowBox[{"d", "=", 
         RowBox[{"dvec", "[", 
          RowBox[{"kx", ",", "ky"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"dx", "=", 
         RowBox[{"gradX", "[", 
          RowBox[{"kx", ",", "ky"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"dy", "=", 
         RowBox[{"gradY", "[", 
          RowBox[{"kx", ",", "ky"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Dot", "[", 
          RowBox[{"d", ",", 
           RowBox[{"Cross", "[", 
            RowBox[{"dx", ",", "dy"}], "]"}]}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Norm", "[", "d", "]"}], "^", "3"}], ")"}]}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"chernDVector", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"4", " ", "Pi"}], ")"}]}], ")"}], "*", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{"integrand", "[", 
         RowBox[{"kx", ",", "ky"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"kx", ",", 
          RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"ky", ",", 
          RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
        RowBox[{"Method", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
           RowBox[{"\"\<MaxErrorIncreases\>\"", "->", "5000"}]}], "}"}]}], ",", 
        RowBox[{"PrecisionGoal", "->", "3"}], ",", 
        RowBox[{"AccuracyGoal", "->", "12"}], ",", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "Tells", " ", "it", " ", "to", " ", "stop", " ", "if", " ", "the", " ",
            "value", " ", "is"}], "<", 
          RowBox[{"10", "^", 
           RowBox[{"-", "5"}]}]}], "*)"}], 
        RowBox[{"MaxPoints", "->", "1000000"}]}], "]"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Give", " ", "it", " ", "more", " ", "room", " ", "to", " ", "breathe"}], 
    "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Chern Number (d-vector way): \>\"", ",", "chernDVector"}], 
    "]"}], "\[IndentingNewLine]"}]}]], "Input",
