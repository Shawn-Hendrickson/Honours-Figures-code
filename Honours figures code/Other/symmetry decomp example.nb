Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"PlotIrrep", ",", "MakeLabel"}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PlotIrrep", "[", "func_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "plot", ",", "lines", ",", "hex", ",", "vertices", ",", "\[Theta]", ",",
         "dir", ",", "intersection"}], "}"}], ",", 
      RowBox[{
       RowBox[{"vertices", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"1", "/", "2"}], ",", 
            RowBox[{
             RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "1"}], "/", "2"}], ",", 
            RowBox[{
             RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "1"}], "/", "2"}], ",", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"Sqrt", "[", "3", "]"}]}], "/", "2"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"1", "/", "2"}], ",", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"Sqrt", "[", "3", "]"}]}], "/", "2"}]}], "}"}]}], 
         "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"hex", "=", 
        RowBox[{"Polygon", "[", "vertices", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"plot", "=", 
        RowBox[{"RegionPlot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"func", "[", 
               RowBox[{"x", ",", "y"}], "]"}], ">", "0"}], "&&", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", "x", "]"}], "+", 
               RowBox[{
                RowBox[{"Abs", "[", "y", "]"}], "/", 
                RowBox[{"Sqrt", "[", "3", "]"}]}]}], "<=", "1"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"func", "[", 
               RowBox[{"x", ",", "y"}], "]"}], "<", "0"}], "&&", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", "x", "]"}], "+", 
               RowBox[{
                RowBox[{"Abs", "[", "y", "]"}], "/", 
                RowBox[{"Sqrt", "[", "3", "]"}]}]}], "<=", "1"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"Sqrt", "[", "3", "]"}]}], "/", "2"}], ",", 
            RowBox[{
             RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Directive", "[", 
              RowBox[{
               RowBox[{"RGBColor", "[", "\"\<#f98a80\>\"", "]"}], ",", 
               RowBox[{"EdgeForm", "[", "None", "]"}]}], "]"}], ",", 
             RowBox[{"Directive", "[", 
              RowBox[{
               RowBox[{"RGBColor", "[", "\"\<#7eb4e0\>\"", "]"}], ",", 
               RowBox[{"EdgeForm", "[", "None", "]"}]}], "]"}]}], "}"}]}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"BoundaryStyle", "->", "None"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Frame", "->", "False"}], ",", "\[IndentingNewLine]", 
          RowBox[{"PlotPoints", "->", "100"}], ",", "\[IndentingNewLine]", 
          RowBox[{"MaxRecursion", "->", "3"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"lines", "=", 
        RowBox[{"Graphics", "[", 
         RowBox[{"{", 
          RowBox[{"Thin", ",", " ", 
           RowBox[{"GrayLevel", "[", "0.4", "]"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"\[Theta]", "=", 
               RowBox[{"n", " ", 
                RowBox[{"Pi", "/", "6"}]}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"dir", "=", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", 
                 RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "}"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"intersection", "=", 
               RowBox[{"RegionIntersection", "[", 
                RowBox[{
                 RowBox[{"Line", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"-", "2"}], " ", "dir"}], ",", 
                    RowBox[{"2", " ", "dir"}]}], "}"}], "]"}], ",", "hex"}], 
                "]"}]}], ";", "\[IndentingNewLine]", "intersection"}], ",", 
             RowBox[{"{", 
              RowBox[{"n", ",", "0", ",", "5"}], "}"}]}], "]"}]}], "}"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"hex", "=", 
        RowBox[{"Graphics", "[", 
         RowBox[{"{", 
          RowBox[{"Thin", ",", 
           RowBox[{"GrayLevel", "[", "0.4", "]"}], ",", 
           RowBox[{"Line", "[", 
            RowBox[{"Append", "[", 
             RowBox[{"vertices", ",", 
              RowBox[{"First", "[", "vertices", "]"}]}], "]"}], "]"}]}], 
          "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Show", "[", 
        RowBox[{"plot", ",", "lines", ",", "hex", ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"-", 
                RowBox[{"Sqrt", "[", "3", "]"}]}], "/", "2"}], ",", 
              RowBox[{
               RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}]}], "}"}]}], 
           "}"}]}], ",", 
         RowBox[{"AspectRatio", "->", 
          RowBox[{
           RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}]}], ",", 
         RowBox[{"ImageSize", "->", "200"}]}], "]"}]}]}], "]"}]}], ";"}], 
  "\n", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
