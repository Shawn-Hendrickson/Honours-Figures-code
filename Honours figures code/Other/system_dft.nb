Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Xi", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], " ", "t", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Cos", "[", "x", "]"}], "+", 
         RowBox[{"Cos", "[", "y", "]"}]}], ")"}]}], "-", "mu"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Delta", "[", 
      RowBox[{"x_", ",", "y_", ",", "phi_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"d1", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Cos", "[", "x", "]"}], "+", 
         RowBox[{"Cos", "[", "y", "]"}]}], ")"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", "*", "phi"}], "]"}]}], "+", 
      RowBox[{"d2", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Sin", "[", "x", "]"}], "+", 
         RowBox[{"I", " ", 
          RowBox[{"Sin", "[", "y", "]"}]}]}], ")"}]}], "+", 
      RowBox[{"0.05", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Cos", "[", "x", "]"}], "+", 
         RowBox[{"Cos", "[", "y", "]"}]}], ")"}]}]}]}], 
    RowBox[{"(*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Cos", "[", "x", "]"}], "-", 
       RowBox[{"Cos", "[", "y", "]"}]}], ")"}], "*)"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Dispersion", "[", 
      RowBox[{"x_", ",", "y_", ",", "phi_"}], "]"}], ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Xi", "[", 
         RowBox[{"x", ",", "y"}], "]"}], "^", "2"}], "+", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"Delta", "[", 
          RowBox[{"x", ",", "y", ",", "phi"}], "]"}], "]"}], "^", "2"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"vSquared", "[", 
      RowBox[{"x_", ",", "y_", ",", "phi_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         RowBox[{"Xi", "[", 
          RowBox[{"x", ",", "y"}], "]"}], "/", 
         RowBox[{"Dispersion", "[", 
          RowBox[{"x", ",", "y", ",", "phi"}], "]"}]}]}], ")"}], "/", "2"}]}],
     ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Intensity", "[", 
      RowBox[{"x_", ",", "y_", ",", "phi_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"vSquared", "[", 
         RowBox[{"x", ",", "y", ",", "phi"}], "]"}], "/", "Pi"}], ")"}], "*", 
      
      RowBox[{"(", 
       RowBox[{"g", "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"Dispersion", "[", 
               RowBox[{"0", ",", "0", ",", "phi"}], "]"}]}], "+", 
             RowBox[{"Dispersion", "[", 
              RowBox[{"x", ",", "y", ",", "phi"}], "]"}]}], ")"}], "^", "2"}],
           "+", 
          RowBox[{"g", "^", "2"}]}], ")"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"phiValues", "=", 
     RowBox[{"Subdivide", "[", 
      RowBox[{"0", ",", 
       RowBox[{
        RowBox[{"2", " ", "Pi"}], "-", 
        RowBox[{"2", " ", 
         RowBox[{"Pi", "/", "nPhi"}]}]}], ",", 
       RowBox[{"nPhi", "-", "1"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"expFactors", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], "*", "phiValues"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"c1Data", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "intensities", "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"intensities", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Intensity", "[", 
              RowBox[{"x", ",", "y", ",", "p"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"p", ",", "phiValues"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Mean", "[", 
           RowBox[{"intensities", "*", "expFactors"}], "]"}]}]}], "]"}], ",", 
       
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"Reverse", "[", 
          RowBox[{"Subdivide", "[", 
           RowBox[{
            RowBox[{"offset", "-", "Pi"}], ",", 
            RowBox[{"offset", "+", "Pi"}], ",", 
            RowBox[{"nXY", "-", "1"}]}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"Subdivide", "[", 
          RowBox[{
           RowBox[{"offset", "-", "Pi"}], ",", 
           RowBox[{"offset", "+", "Pi"}], ",", 
           RowBox[{"nXY", "-", "1"}]}], "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
