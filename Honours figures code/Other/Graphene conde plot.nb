       RowBox[{"0.58", ",", "0.20", ",", "0.08"}], "]"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kRadius", "=", 
    RowBox[{"N", "[", 
     RowBox[{"4", " ", 
      RowBox[{"Pi", "/", "3"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
