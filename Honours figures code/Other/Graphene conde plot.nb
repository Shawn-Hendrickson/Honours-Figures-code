      RowBox[{"x_", "?", "NumericQ"}], ",", 
      RowBox[{"y_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"Max", "[", 
      RowBox[{"0.", ",", 
       RowBox[{"1", "+", 
        RowBox[{"4", " ", 
         RowBox[{
          RowBox[{"Cos", "[", 
