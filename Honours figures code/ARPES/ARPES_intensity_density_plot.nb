Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Xi", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "\[Mu]"}], "-", 
    RowBox[{"2", " ", "t", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Cos", "[", "x", "]"}], "+", 
       RowBox[{"Cos", "[", "y", "]"}]}], ")"}]}]}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Extra", " ", "terms", " ", "commented", " ", "for", " ", "testing", " ", 
    "effects", " ", "of", " ", 
    RowBox[{"different", "/", "extra"}], " ", "order", " ", "parameter", " ", 
    "terms"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Delta", "[", 
     RowBox[{"x_", ",", "y_", ",", "\[Phi]_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"d1", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Cos", "[", "x", "]"}], "+", 
        RowBox[{"Cos", "[", "y", "]"}]}], ")"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", "*", "\[Phi]"}], "]"}]}], "+", 
     RowBox[{"d2", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Sin", "[", "x", "]"}], "+", 
        RowBox[{"0", "I", " ", 
         RowBox[{"Sin", "[", "y", "]"}]}], "+", 
        RowBox[{"0.5", 
         RowBox[{"Sin", "[", "y", "]"}]}]}], ")"}]}]}]}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"+", "d2"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Cos", "[", "x", "]"}], "+", 
       RowBox[{"Cos", "[", "y", "]"}]}], ")"}]}], "*)"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"+", "d3"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Cos", "[", "x", "]"}], "+", 
       RowBox[{"Cos", "[", "y", "]"}]}], ")"}]}], "*)"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Dispersion", "[", 
    RowBox[{"x_", ",", "y_", ",", "\[Phi]_"}], "]"}], ":=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Xi", "[", 
       RowBox[{"x", ",", "y"}], "]"}], "^", "2"}], "+", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"Delta", "[", 
        RowBox[{"x", ",", "y", ",", "\[Phi]"}], "]"}], "]"}], "^", "2"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vSquared", "[", 
    RowBox[{"x_", ",", "y_", ",", "\[Phi]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"Xi", "[", 
        RowBox[{"x", ",", "y"}], "]"}], "/", 
       RowBox[{"Dispersion", "[", 
        RowBox[{"x", ",", "y", ",", "\[Phi]"}], "]"}]}]}], ")"}], "/", 
    "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ARPESIntensity", "[", 
    RowBox[{"kx_", ",", "ky_", ",", "\[Phi]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"vSquared", "[", 
      RowBox[{"kx", ",", "ky", ",", "\[Phi]"}], "]"}], "/", "Pi"}], "*", 
    RowBox[{"g", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Dispersion", "[", 
            RowBox[{"0", ",", "0", ",", "\[Phi]"}], "]"}]}], "+", 
          RowBox[{"Dispersion", "[", 
           RowBox[{"kx", ",", "ky", ",", "\[Phi]"}], "]"}]}], ")"}], "^", 
        "2"}], "+", 
       RowBox[{"g", "^", "2"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{4.002859128033125*^9, 
