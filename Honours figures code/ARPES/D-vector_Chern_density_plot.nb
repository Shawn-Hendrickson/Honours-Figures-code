Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"DeltaE", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dVec", "[", 
     RowBox[{"kx_", ",", "ky_", ",", "dA1_", ",", "eps0_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"DeltaE", "*", 
        RowBox[{"Sin", "[", "kx", "]"}]}], "+", 
       RowBox[{"dA1", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Cos", "[", "kx", "]"}], "+", 
          RowBox[{"Cos", "[", "ky", "]"}]}], ")"}]}]}], ",", 
      RowBox[{"DeltaE", "*", 
       RowBox[{"Sin", "[", "ky", "]"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Cos", "[", "kx", "]"}], "+", 
          RowBox[{"Cos", "[", "ky", "]"}]}], ")"}]}], "-", "eps0"}]}], 
     "}"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"integrandFormula", "[", 
     RowBox[{"kx_", ",", "ky_", ",", "dA1_", ",", "eps0_"}], "]"}], "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"d", "=", 
         RowBox[{"dVec", "[", 
          RowBox[{"kx", ",", "ky", ",", "dA1", ",", "eps0"}], "]"}]}], "}"}], 
       ",", 
       RowBox[{
        RowBox[{"Dot", "[", 
         RowBox[{"d", ",", 
          RowBox[{"Cross", "[", 
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{"d", ",", "kx"}], "]"}], ",", 
            RowBox[{"D", "[", 
             RowBox[{"d", ",", "ky"}], "]"}]}], "]"}]}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Norm", "[", "d", "]"}], "^", "3"}], ")"}]}]}], "]"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"computeChern", "[", 
     RowBox[{"dA1_", ",", "eps0_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "val", "}"}], ",", 
      RowBox[{
       RowBox[{"val", "=", 
        RowBox[{"Quiet", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "/", 
            RowBox[{"(", 
             RowBox[{"4", " ", "Pi"}], ")"}]}], ")"}], "*", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{"integrandFormula", "[", 
             RowBox[{"kx", ",", "ky", ",", "dA1", ",", "eps0"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"kx", ",", 
              RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ky", ",", 
              RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
            RowBox[{"PrecisionGoal", "->", "5"}], ",", 
            RowBox[{"AccuracyGoal", "->", "6"}], ",", 
            RowBox[{"MaxRecursion", "->", "20"}], ",", 
            RowBox[{"Method", "->", "\"\<GlobalAdaptive\>\""}]}], "]"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Round", "[", "val", "]"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dA1Range", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", 
     RowBox[{"1.5", "*", "DeltaE"}], ",", "0.005"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eps0Range", "=", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", "4.1", ",", "0.01"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LaunchKernels", "[", "]"}], ";"}], "\n", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DistributeDefinitions", "[", 
    RowBox[{
    "DeltaE", ",", "dVec", ",", "integrandFormula", ",", "computeChern"}], 
    "]"}], ";"}], "\n", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"phaseData", "=", 
    RowBox[{"ParallelTable", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"dA1", "/", "DeltaE"}], ",", "eps0", ",", 
        RowBox[{"computeChern", "[", 
         RowBox[{"dA1", ",", "eps0"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"dA1", ",", "dA1Range"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"eps0", ",", "eps0Range"}], "}"}], ",", 
      RowBox[{"Method", "->", "\"\<FinestGrained\>\""}]}], " ", "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plotData", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{"phaseData", ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\n"}], "\n"}], "Input",
