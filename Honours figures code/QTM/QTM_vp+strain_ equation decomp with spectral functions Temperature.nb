Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[ScriptCapitalR]UC", "=", 
     RowBox[{"Polygon", "[", 
      RowBox[{
       FractionBox["1", 
        SqrtBox["3"]], 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cos", "[", 
             RowBox[{
              RowBox[{"2", " ", "Pi", " ", 
               RowBox[{"k", "/", "6"}]}], "+", 
              RowBox[{"0", 
               RowBox[{"\[Pi]", "/", "2"}]}]}], "]"}], ",", 
            RowBox[{"Sin", "[", 
             RowBox[{
              RowBox[{"2", " ", "Pi", " ", 
               RowBox[{"k", "/", "6"}]}], "+", 
              RowBox[{"0", 
               RowBox[{"\[Pi]", "/", "2"}]}]}], "]"}]}], "}"}], ")"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "6"}], "}"}]}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"h", "[", 
     RowBox[{"x_", ",", "y_", ",", "0"}], "]"}], ":=", 
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{
             RowBox[{"2", " ", "Pi", " ", 
              RowBox[{"k", "/", "6"}]}], "+", 
             RowBox[{"0", 
              RowBox[{"\[Pi]", "/", "2"}]}]}], "]"}], "+", "x"}], ",", 
          RowBox[{
           RowBox[{"Sin", "[", 
            RowBox[{
             RowBox[{"2", " ", "Pi", " ", 
              RowBox[{"k", "/", "6"}]}], "+", 
             RowBox[{"0", 
              RowBox[{"\[Pi]", "/", "2"}]}]}], "]"}], "+", "y"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "6"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"hexGrid", "[", 
      RowBox[{"N_Integer", "?", "NonNegative"}], "]"}], ":=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"i", "+", 
            RowBox[{"j", "/", "2"}]}], ",", 
           RowBox[{
            RowBox[{"Sqrt", "[", "3", "]"}], " ", 
            RowBox[{"j", "/", "2"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"-", "N"}], ",", "N"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"-", "N"}], ",", 
             RowBox[{
              RowBox[{"-", "i"}], "-", "N"}]}], "]"}], ",", 
           RowBox[{"Min", "[", 
            RowBox[{"N", ",", 
             RowBox[{
              RowBox[{"-", "i"}], "+", "N"}]}], "]"}]}], "}"}]}], "]"}], ",", 
       "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalLambda]N", "=", "10"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"UCmesh", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", "2", "]"}], "/", 
         RowBox[{"Sqrt", "[", "3", "]"}]}]}], ")"}], "*", 
      RowBox[{
       RowBox[{"hexGrid", "[", "\[CapitalLambda]N", "]"}], "/", 
       RowBox[{"(", 
        RowBox[{"\[CapitalLambda]N", "+", "1"}], ")"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"kList", "=", 
     RowBox[{"DeleteCases", "[", 
      RowBox[{"UCmesh", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "]"}]}], ";"}]}]}]], "Input",
