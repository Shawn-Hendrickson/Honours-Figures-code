Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Things", " ", "ending", " ", "with", " ", "T", " ", "denote", " ", 
     "functions", " ", "representing", " ", "the", " ", "tip"}], ",", " ", 
    RowBox[{
    "functions", " ", "ending", " ", "with", " ", "s", " ", "denote", " ", 
     "functions", " ", "representing", " ", "the", " ", "sample"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Xi]T", "[", 
      RowBox[{"k_", ",", "\[Tau]_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"-", "\[Mu]"}], "+", 
      RowBox[{"Norm", "[", "k", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Xi]S", "[", 
      RowBox[{"k_", ",", "\[Tau]_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"-", "\[Mu]"}], "+", 
      RowBox[{"Norm", "[", "k", "]"}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"DispersionS", "[", 
      RowBox[{"k_", ",", "\[CapitalDelta]_", ",", "\[Tau]_"}], "]"}], ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Xi]S", "[", 
         RowBox[{"k", ",", "\[Tau]"}], "]"}], "^", "2"}], "+", 
       RowBox[{
        RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}], "^", "2"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"DispersionT", "[", 
      RowBox[{"k_", ",", "\[CapitalDelta]_", ",", "\[Tau]_"}], "]"}], ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Xi]T", "[", 
         RowBox[{"k", ",", "\[Tau]"}], "]"}], "^", "2"}], "+", 
       RowBox[{
        RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}], "^", "2"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"uT", "[", 
      RowBox[{"k_", ",", " ", "\[CapitalDelta]_", ",", " ", "\[Tau]_"}], 
      "]"}], ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         FractionBox[
          RowBox[{"\[Xi]T", "[", 
           RowBox[{"k", ",", "\[Tau]"}], "]"}], 
          RowBox[{"DispersionT", "[", 
           RowBox[{"k", ",", "\[CapitalDelta]", ",", "\[Tau]"}], "]"}]]}], 
        ")"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"uS", "[", 
      RowBox[{"k_", ",", "\[CapitalDelta]_", ",", "\[Tau]_"}], "]"}], ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         FractionBox[
          RowBox[{"\[Xi]S", "[", 
           RowBox[{"k", ",", "\[Tau]"}], "]"}], 
          RowBox[{"DispersionS", "[", 
           RowBox[{"k", ",", "\[CapitalDelta]", ",", "\[Tau]"}], "]"}]]}], 
        ")"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"vT", "[", 
      RowBox[{"k_", ",", "\[CapitalDelta]_", ",", "\[Tau]_"}], "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"\[CapitalDelta]", "==", "0"}], ",", "0", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Conjugate", "[", "\[CapitalDelta]", "]"}], "/", 
