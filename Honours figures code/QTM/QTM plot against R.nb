Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"w1", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"w0", "=", 
     RowBox[{"0.75", "w1"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Mu]", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mv", "=", 
     RowBox[{"-", "0.5"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"epsx", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"epsy", "=", 
     RowBox[{"-", "0.5"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a", "=", 
     RowBox[{"1.42", 
      RowBox[{"Sqrt", "[", "3", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thetaTwist", "=", 
     RowBox[{"1.05", "Degree"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Ktheta", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4", " ", 
        RowBox[{"Pi", "/", 
         RowBox[{"(", 
          RowBox[{"3", " ", "a"}], ")"}]}]}], ")"}], " ", "2", " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"thetaTwist", "/", "2"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"q0", "=", 
     RowBox[{"Ktheta", " ", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", "0.4"}], "}"}], 
      SqrtBox["2"]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"qList", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"RotationMatrix", "[", 
         RowBox[{"2", " ", "Pi", " ", 
          RowBox[{"n", "/", "3"}]}], "]"}], ".", "q0"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "0", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"G", "[", "1", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"G", "[", "2", "]"}], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4", " ", 
        RowBox[{"Pi", "/", 
         RowBox[{"(", 
          RowBox[{"3", " ", "a"}], ")"}]}]}], ")"}], " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "3"}], "/", "2"}], ",", 
        RowBox[{
