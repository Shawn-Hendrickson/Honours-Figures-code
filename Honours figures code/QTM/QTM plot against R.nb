          RowBox[{"3", " ", "a"}], ")"}]}]}], ")"}], " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "3"}], "/", "2"}], ",", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Sqrt", "[", "3", "]"}]}], "/", "2"}]}], "}"}]}]}], ";"}], 
