Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ElectronSpectral", "[", 
      RowBox[{"xi_", ",", "delta_", ",", "omega_", ",", "gamma_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"energy", ",", "u2", ",", "v2"}], "}"}], ",", 
       RowBox[{
        RowBox[{"energy", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"xi", "^", "2"}], "+", 
           RowBox[{
            RowBox[{"Abs", "[", "delta", "]"}], "^", "2"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"TrueQ", "[", 
           RowBox[{"energy", "==", "0"}], "]"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"gamma", "/", 
            RowBox[{"(", 
             RowBox[{"Pi", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"omega", "^", "2"}], "+", 
                RowBox[{"gamma", "^", "2"}]}], ")"}]}], ")"}]}], "]"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"u2", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"xi", "/", "energy"}]}], ")"}], "/", "2"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"v2", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"xi", "/", "energy"}]}], ")"}], "/", "2"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"gamma", "/", "Pi"}], ")"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"u2", "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"omega", "-", "energy"}], ")"}], "^", "2"}], "+", 
              RowBox[{"gamma", "^", "2"}]}], ")"}]}], "+", 
           RowBox[{"v2", "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"omega", "+", "energy"}], ")"}], "^", "2"}], "+", 
              RowBox[{"gamma", "^", "2"}]}], ")"}]}]}], ")"}]}]}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"AT", "[", 
      RowBox[{"k_", ",", "omega_", ",", "tau_"}], "]"}], ":=", 
     RowBox[{"ElectronSpectral", "[", 
      RowBox[{
       RowBox[{"\[Xi]T", "[", 
        RowBox[{"k", ",", "tau"}], "]"}], ",", 
       RowBox[{"DeltaT", "[", "k", "]"}], ",", "omega", ",", "gammaT"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"AS", "[", 
      RowBox[{"k_", ",", "omega_", ",", "tau_", ",", "lambda_"}], "]"}], ":=", 
     RowBox[{"ElectronSpectral", "[", 
      RowBox[{
       RowBox[{"\[Xi]S", "[", 
        RowBox[{"k", ",", "tau"}], "]"}], ",", 
       RowBox[{"DeltaS", "[", 
        RowBox[{"k", ",", "lambda"}], "]"}], ",", "omega", ",", "gammaS"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SpectralOverlap", "[", 
      RowBox[{"k_", ",", "q_", ",", "tau_", ",", 
       RowBox[{"lambda_", "?", "NumericQ"}], ",", 
       RowBox[{"b_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "kp", ",", "enT", ",", "enS", ",", "lo", ",", "hi", ",", "cuts", ",", 
         "integrand", ",", "omega"}], "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"TrueQ", "[", 
           RowBox[{"b", "==", "0"}], "]"}], ",", 
          RowBox[{"Return", "[", "0.", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"kp", "=", 
         RowBox[{"k", "+", "q"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"enT", "=", 
         RowBox[{"N", "[", 
          RowBox[{"DispersionT", "[", 
           RowBox[{"kp", ",", 
            RowBox[{"DeltaT", "[", "kp", "]"}], ",", "tau"}], "]"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"enS", "=", 
         RowBox[{"N", "[", 
          RowBox[{"DispersionS", "[", 
           RowBox[{"k", ",", 
            RowBox[{"DeltaS", "[", 
             RowBox[{"k", ",", "lambda"}], "]"}], ",", "tau"}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"lo", "=", 
         RowBox[{"N", "[", 
          RowBox[{"Min", "[", 
           RowBox[{
            RowBox[{"-", "b"}], ",", "0."}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"hi", "=", 
         RowBox[{"N", "[", 
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"-", "b"}], ",", "0."}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"cuts", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"lo", ",", "hi"}], "}"}], ",", 
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{"N", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "enS"}], ",", "enS", ",", 
                  RowBox[{
                   RowBox[{"-", "b"}], "-", "enT"}], ",", 
                  RowBox[{
                   RowBox[{"-", "b"}], "+", "enT"}]}], "}"}], "]"}], ",", 
               RowBox[{
                RowBox[{"lo", "<", "#", "<", "hi"}], "&"}]}], "]"}]}], "]"}], 
           "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"integrand", "[", 
          RowBox[{"omega_", "?", "NumericQ"}], "]"}], ":=", 
         RowBox[{
          RowBox[{"AT", "[", 
           RowBox[{"kp", ",", 
            RowBox[{"omega", "+", "b"}], ",", "tau"}], "]"}], "*", 
          RowBox[{"AS", "[", 
           RowBox[{"k", ",", "omega", ",", "tau", ",", "lambda"}], "]"}]}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Sign", "[", "b", "]"}], "*", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{"integrand", "[", "omega", "]"}], ",", 
           RowBox[{"Evaluate", "[", 
            RowBox[{"Prepend", "[", 
             RowBox[{"cuts", ",", "omega"}], "]"}], "]"}], ",", 
           RowBox[{"Method", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
              RowBox[{"\"\<SymbolicProcessing\>\"", "->", "0"}]}], "}"}]}], ",", 
           RowBox[{"AccuracyGoal", "->", "8"}], ",", 
           RowBox[{"PrecisionGoal", "->", "6"}], ",", 
           RowBox[{"MaxRecursion", "->", "20"}]}], "]"}]}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SpectralDerivative", "[", 
      RowBox[{"k_", ",", "q_", ",", "tau_", ",", 
       RowBox[{"lambda_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"SpectralOverlap", "[", 
         RowBox[{"k", ",", "q", ",", "tau", ",", "lambda", ",", 
          RowBox[{"biasEnergy", "+", "dBias"}]}], "]"}], "-", 
        RowBox[{"SpectralOverlap", "[", 
         RowBox[{"k", ",", "q", ",", "tau", ",", "lambda", ",", 
          RowBox[{"biasEnergy", "-", "dBias"}]}], "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "dBias"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"IntegrandPLUS", "[", 
      RowBox[{"k_", ",", "q_", ",", "r_", ",", 
       RowBox[{"lambda_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"M", "[", 
         RowBox[{"k", ",", "q", ",", "r", ",", "1", ",", "lambda"}], "]"}], 
        "]"}], "^", "2"}], "*", 
      RowBox[{"SpectralDerivative", "[", 
       RowBox[{"k", ",", "q", ",", "1", ",", "lambda"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"IntegrandMINUS", "[", 
      RowBox[{"k_", ",", "q_", ",", "r_", ",", 
       RowBox[{"lambda_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"M", "[", 
         RowBox[{"k", ",", 
          RowBox[{"-", "q"}], ",", "r", ",", 
          RowBox[{"-", "1"}], ",", "lambda"}], "]"}], "]"}], "^", "2"}], "*", 
      RowBox[{"SpectralDerivative", "[", 
       RowBox[{"k", ",", 
        RowBox[{"-", "q"}], ",", 
        RowBox[{"-", "1"}], ",", "lambda"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Signal", "[", 
      RowBox[{"r_", ",", 
       RowBox[{"lambda_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"IntegrandPLUS", "[", 
         RowBox[{"k", ",", "q", ",", "r", ",", "lambda"}], "]"}], "+", 
