Notebook[{
Cell["\<\
Note: To run this file, first run /QTM/Hexagonal_Decomp, as it defines the \
real space displacement set, as well as computed the C6v eigenvectors used to \
decompose the measurement\
\>", "Text",
 CellChangeTimes->{{4.0028605608571243`*^9, 
  4.0028606299007874`*^9}},ExpressionUUID->"eb5b4d62-74d6-9d4f-87b1-\
6d2a6c883ee1"],

Cell[CellGroupData[{

Cell["Hexagonal Grid", "Subsection",
 CellChangeTimes->{{3.995244610714655*^9, 3.9952446216778526`*^9}, {
  4.0028605488869915`*^9, 
  4.002860554381443*^9}},ExpressionUUID->"9ff1b3ac-5eae-db4d-8ba8-\
0c570bbf3a00"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[ScriptCapitalR]UC", "=", 
     RowBox[{"Polygon", "[", 
      RowBox[{
       FractionBox["1", 
        SqrtBox["3"]], 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cos", "[", 
             RowBox[{
              RowBox[{"2", " ", "Pi", " ", 
               RowBox[{"k", "/", "6"}]}], "+", 
              RowBox[{"0", 
               RowBox[{"\[Pi]", "/", "2"}]}]}], "]"}], ",", 
            RowBox[{"Sin", "[", 
             RowBox[{
              RowBox[{"2", " ", "Pi", " ", 
               RowBox[{"k", "/", "6"}]}], "+", 
              RowBox[{"0", 
               RowBox[{"\[Pi]", "/", "2"}]}]}], "]"}]}], "}"}], ")"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "6"}], "}"}]}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"h", "[", 
     RowBox[{"x_", ",", "y_", ",", "0"}], "]"}], ":=", 
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{
             RowBox[{"2", " ", "Pi", " ", 
              RowBox[{"k", "/", "6"}]}], "+", 
             RowBox[{"0", 
              RowBox[{"\[Pi]", "/", "2"}]}]}], "]"}], "+", "x"}], ",", 
          RowBox[{
           RowBox[{"Sin", "[", 
            RowBox[{
             RowBox[{"2", " ", "Pi", " ", 
              RowBox[{"k", "/", "6"}]}], "+", 
             RowBox[{"0", 
              RowBox[{"\[Pi]", "/", "2"}]}]}], "]"}], "+", "y"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "6"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"h", "[", 
     RowBox[{"x_", ",", "y_", ",", "n_"}], "]"}], ":=", 
    RowBox[{"DeleteDuplicates", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Cos", "[", 
               RowBox[{
                RowBox[{"2", " ", "Pi", " ", 
                 RowBox[{"k", "/", "6"}]}], "+", 
                RowBox[{"0", 
                 RowBox[{"\[Pi]", "/", "2"}]}]}], "]"}], "+", "#1"}], ",", 
             RowBox[{
              RowBox[{"Sin", "[", 
               RowBox[{
                RowBox[{"2", " ", "Pi", " ", 
                 RowBox[{"k", "/", "6"}]}], "+", 
                RowBox[{"0", 
                 RowBox[{"\[Pi]", "/", "2"}]}]}], "]"}], "+", "#2"}]}], "}"}],
            ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "6"}], "}"}]}], "]"}], "&"}], "@@@", 
        RowBox[{"h", "[", 
         RowBox[{"x", ",", "y", ",", 
          RowBox[{"n", "-", "1"}]}], "]"}]}], ",", "1"}], "]"}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalLambda]N", "=", "20"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"UCmesh", "=", 
     RowBox[{"2", 
      SqrtBox["2"], 
      FractionBox["1", 
       SqrtBox["3"]], 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"0", ",", "0", ",", "\[CapitalLambda]N"}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{"\[CapitalLambda]N", "+", "1"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kList", "=", 
     RowBox[{"DeleteCases", "[", 
      RowBox[{"UCmesh", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"EdgeForm", "[", "Thick", "]"}], ",", "Transparent", ",", 
        "\[ScriptCapitalR]UC"}], "}"}], "]"}], ",", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"UCmesh", ",", 
       RowBox[{"AspectRatio", "\[Rule]", "1"}]}], "]"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"UCmesh", ",", "kList"}], "}"}], ",", 
     RowBox[{"AspectRatio", "\[Rule]", "1"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.995240708319845*^9, 3.995240716612911*^9}, {
  3.995244587369467*^9, 3.9952445880325603`*^9}, {3.9953632471226673`*^9, 
  3.9953632474676685`*^9}, {4.00286064750741*^9, 
  4.0028606478434105`*^9}},ExpressionUUID->"8bf8eab2-2d57-1641-8aaa-\
c33a815c3dc7"],

