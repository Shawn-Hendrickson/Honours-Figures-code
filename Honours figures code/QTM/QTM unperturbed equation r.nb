     RowBox[{
      RowBox[{"vec", "=", 
       RowBox[{"ConductanceVec", "[", "lambda", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"a1", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"evA1", ".", "vec"}], ")"}], "/", "a10"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"a2", "=", 
       RowBox[{"Chop", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"evA2", ".", "vec"}], ")"}], "/", "a10"}], ",", 
         RowBox[{"10", "^", 
          RowBox[{"-", "6"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"b1", "=", 
       RowBox[{"Chop", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"evB1", ".", "vec"}], ")"}], "/", "a10"}], ",", 
         RowBox[{"10", "^", 
          RowBox[{"-", "6"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"b2", "=", 
       RowBox[{"Chop", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"evB2", ".", "vec"}], ")"}], "/", "a10"}], ",", 
         RowBox[{"10", "^", 
          RowBox[{"-", "6"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"e1", "=", 
       RowBox[{"Chop", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#", ".", "vec"}], ")"}], "/", "a10"}], "&"}], ")"}], "/@",
           "evE1"}], ",", 
         RowBox[{"10", "^", 
          RowBox[{"-", "6"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"e2", "=", 
       RowBox[{"Chop", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"#", ".", "vec"}], ")"}], "/", "a10"}], "&"}], ")"}], "/@",
            "evE2"}]}], ",", 
         RowBox[{"10", "^", 
          RowBox[{"-", "6"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"a1", ",", "a2", ",", "b1", ",", "b2", ",", "e1", ",", "e2"}], 
       "}"}]}]}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lambdaList", "=", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", "0.240", ",", "0.02"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"results", "=", 
   RowBox[{"Monitor", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"SymmetryDecomp", "[", 
        RowBox[{"lambdaList", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "lambdaList", "]"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<Lambda: \>\"", ",", 
        RowBox[{"Dynamic", "[", "i", "]"}], ",", "\"\< / \>\"", ",", 
        RowBox[{"Length", "[", "lambdaList", "]"}], ",", "\"\<   \>\"", ",", 
        RowBox[{"ProgressIndicator", "[", 
         RowBox[{
          RowBox[{"Dynamic", "[", "i", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"Length", "[", "lambdaList", "]"}]}], "}"}]}], "]"}]}], 
       "}"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A1vals", "=", 
