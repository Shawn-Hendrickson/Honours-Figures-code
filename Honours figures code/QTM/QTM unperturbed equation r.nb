   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ConductanceVec", "[", "lambda_", "]"}], ":=", 
    RowBox[{
     RowBox[{"ConductanceVec", "[", "lambda", "]"}], "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"Signal", "[", 
        RowBox[{"r", ",", "lambda"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "points"}], "}"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
