Cell[BoxData[{
 RowBox[{
  RowBox[{"kList", "=", 
   RowBox[{"N", "[", "kList", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qList", "=", 
    RowBox[{"N", "[", "qList", "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"$KernelCount", "==", "0"}], ",", 
     RowBox[{"LaunchKernels", "[", "]"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"DistributeDefinitions", "[", 
    RowBox[{
    "Signal", ",", "IntegrandPLUS", ",", "IntegrandMINUS", ",", 
     "SpectralDerivative", ",", "SpectralOverlap", ",", "AT", ",", "AS", ",", 
     "ElectronSpectral", ",", "M", ",", "uT", ",", "uS", ",", "vT", ",", "vS",
      ",", "DispersionT", ",", "DispersionS", ",", "\[Xi]T", ",", "\[Xi]S", ",",
      "DeltaT", ",", "DeltaS", ",", "th", ",", "phi", ",", "G", ",", "kList", 
     ",", "qList", ",", "gammaT", ",", "gammaS", ",", "biasEnergy", ",", 
     "dBias", ",", "w0", ",", "w1", ",", "\[Mu]"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"evA1", "=", 
   RowBox[{
    RowBox[{"Eigenvectors", "[", 
     RowBox[{"Subscript", "[", 
      RowBox[{"P", ",", "A1"}], "]"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"evA2", "=", 
   RowBox[{
    RowBox[{"Eigenvectors", "[", 
     RowBox[{"Subscript", "[", 
      RowBox[{"P", ",", "A2"}], "]"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"evB1", "=", 
   RowBox[{
    RowBox[{"Eigenvectors", "[", 
     RowBox[{"Subscript", "[", 
      RowBox[{"P", ",", "B1"}], "]"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"evB2", "=", 
    RowBox[{
     RowBox[{"Eigenvectors", "[", 
      RowBox[{"Subscript", "[", 
       RowBox[{"P", ",", "B2"}], "]"}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"evE1", "=", 
   RowBox[{"Take", "[", 
    RowBox[{
     RowBox[{"Eigenvectors", "[", 
      RowBox[{"Subscript", "[", 
       RowBox[{"P", ",", "E1"}], "]"}], "]"}], ",", "4"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"evE2", "=", 
    RowBox[{"Take", "[", 
     RowBox[{
      RowBox[{"Eigenvectors", "[", 
       RowBox[{"Subscript", "[", 
        RowBox[{"P", ",", "E2"}], "]"}], "]"}], ",", "4"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LaunchKernels", "[", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"DistributeDefinitions", "[", 
    RowBox[{
    "Signal", ",", "IntegrandPLUS", ",", "AT", ",", "AS", ",", 
